{
  "name": "mcp-chat",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "core:test": "cargo test -p mcp-chat-core",
    "core:clippy": "cargo clippy -p mcp-chat-core --all-targets -- -D warnings",
    "mock": "cargo run -p mcp-mock --",
    "version:check": "node scripts/check-versions.mjs",
    "package": "tauri build",
    "package:debug": "tauri build --debug",
    "check": "pnpm version:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm fmt:check && pnpm core:test && pnpm core:clippy && pnpm mock:clippy && cargo test -p mcp-mock",
    "mock:clippy": "cargo clippy -p mcp-mock --all-targets -- -D warnings",
    "fmt:check": "cargo fmt --all -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.34.7"
}
